# === React Native / Expo (the shipping stack) ===
node_modules/
.expo/
dist/
web-build/
expo-env.d.ts
# Continuous Native Generation: these are GENERATED from app.json and the config
# plugins. Never hand-edit them, never commit them.
/ios/
/android/
*.tsbuildinfo

# === Native build output ===
build/
DerivedData/
# Swift Package Manager, if anyone builds the module's deps standalone.
.build/
.swiftpm/

# === Secrets / noise ===
.DS_Store
*.pem
*.key
secrets.plist
.env
.env.local
__pycache__/
*.pyc

# Play upload key: the keystore and its passwords must never be committed.
*.jks
*.keystore
# Google Play service-account key for automated uploads.
play-service-account*.json
