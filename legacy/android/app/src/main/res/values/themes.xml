<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Pre-Compose window chrome only; the UI itself is themed by Compose. -->
    <style name="Theme.HerdrChat" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/appBackground</item>
        <item name="android:statusBarColor">@color/brandGreenDark</item>
    </style>

    <!-- Modern Android 12 splash (backported via core-splashscreen). -->
    <style name="Theme.HerdrChat.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.HerdrChat</item>
    </style>
</resources>
